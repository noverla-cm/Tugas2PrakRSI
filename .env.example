# Salin jadi .env lalu sesuaikan. Jangan commit .env ke GitHub.

DB_SERVER=localhost
DB_PORT=1433
# Login SQL Server yang dibuat oleh db/01-create-login-tugas2.sql (isi password milik Anda sendiri)
DB_USER=
DB_PASSWORD=
DB_NAME=review_kantin

DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Kunci penandatangan JWT (wajib). Isi string acak yang panjang, contoh membuatnya:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Opsional: password untuk akun seed saat menjalankan `npm run seed:passwords` (default Password123)
# SEED_PASSWORD=
