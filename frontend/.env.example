# Salin menjadi .env lalu sesuaikan. Jangan commit file .env.

# Base URL API yang dipanggil Axios.
#  - Default "/api/v1": diteruskan oleh proxy Vite ke backend (tanpa CORS).
#  - Alternatif: URL penuh, mis. http://localhost:3000/api/v1 (backend WAJIB mengaktifkan CORS).
VITE_API_BASE_URL=/api/v1

# Alamat backend Express untuk proxy Vite (hanya dipakai saat npm run dev / preview).
VITE_PROXY_TARGET=http://localhost:3000

# Mode uji hak akses (opsional). Jika true, tombol Ubah/Hapus tampil untuk semua
# pengguna yang login, supaya respons 403 dari backend bisa diuji dan dibuktikan.
# Untuk penggunaan normal biarkan false.
VITE_PERMISSION_TEST_MODE=false
